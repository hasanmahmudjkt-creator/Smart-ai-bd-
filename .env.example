# Facebook Meta Developer App Settings
FB_VERIFY_TOKEN=fcommerce_ai_secret_token_123
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# AI Model Provider (GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./fcommerce.db

# Store Default Configuration
DEFAULT_STORE_NAME=F-Commerce Direct Store
DEFAULT_INSIDE_CITY_FEE=60.0
DEFAULT_OUTSIDE_CITY_FEE=120.0
DEFAULT_CURRENCY=BDT
